<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Torcav</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>torcav</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>Torcav uses the camera only for indoor heatmap surveys — to track your position and map Wi-Fi signal strength room by room. No video or photos leave the device.</string>
		<key>NSMotionUsageDescription</key>
		<string>Torcav uses motion sensors (step counter, barometer) to follow your position as you walk through rooms during a heatmap survey. Motion data stays on the device.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Torcav uses location only to read nearby Wi-Fi BSSIDs (Apple requires location to expose Wi-Fi scan results). Your GPS coordinates are not stored or transmitted.</string>
		<key>NSLocalNetworkUsageDescription</key>
		<string>Torcav scans your local Wi-Fi network for devices, open ports and security issues. Scanning only runs on networks you confirm you are authorized to audit.</string>
		<!-- Background monitoring (opt-in feature). Only fires when the user
	     enables Settings → Privacy → Background monitoring. -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>dev.halilibrahim.torcav.refresh</string>
		</array>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
