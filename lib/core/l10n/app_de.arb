    "privacyWifiAnalysisTitle": "Wi-Fi- & Netzwerkanalyse",
    "@privacyWifiAnalysisTitle": {
        "description": "Label for privacyWifiAnalysisTitle"
    },
    "privacyWifiAnalysisBody": "SSID/BSSID/RSSI-Metadaten und Sicherheits-Flags (WPA2/WPA3/WPS/PMF) naher Netze werden über die OS-Scan-API gelesen. Die Daten bleiben in einer lokalen, verschlüsselten SQLite-Datenbank. Sie werden nie hochgeladen.",
    "@privacyWifiAnalysisBody": {
        "description": "Label for privacyWifiAnalysisBody"
    },
    "privacyLanInventoryTitle": "LAN-Geräteinventar",
    "@privacyLanInventoryTitle": {
        "description": "Label for privacyLanInventoryTitle"
    },
    "privacyLanInventoryBody": "Bei einem LAN-Scan erfasst die App IP/MAC/Hostname/Hersteller/offene Ports der Geräte im selben Netzwerk. Das kann fremde Geräte einschließen — Anonymisierung ist für Exporte standardmäßig aktiv.",
    "@privacyLanInventoryBody": {
        "description": "Label for privacyLanInventoryBody"
    },
    "privacyLocationTitle": "Standortberechtigung (nur Wi-Fi)",
    "@privacyLocationTitle": {
        "description": "Label for privacyLocationTitle"
    },
    "privacyLocationBody": "Android verlangt die Standortberechtigung für Wi-Fi-Scans. Torcav nutzt sie ausschließlich dafür — wir lesen keine GPS-Koordinaten und tracken keine Bewegung.",
    "@privacyLocationBody": {
        "description": "Label for privacyLocationBody"
    },
    "privacySensorsTitle": "Sensoren & Heatmap",
    "@privacySensorsTitle": {
        "description": "Label for privacySensorsTitle"
    },
    "privacySensorsBody": "Aktivitätserkennung + IMU/Barometer werden bei Heatmap-Erfassungen genutzt, um Signalstärke Ihrem relativen Pfad zuzuordnen (Ursprung = Scan-Start). GPS wird nicht verwendet.",
    "@privacySensorsBody": {
        "description": "Label for privacySensorsBody"
    },
    "privacyAiTitle": "KI / Lokale Klassifizierung",
    "@privacyAiTitle": {
        "description": "Label for privacyAiTitle"
    },
    "privacyAiBody": "Die Gerätetyp-Erkennung nutzt ein lokales ONNX-Modell. Keine Hersteller- oder Gerätedaten verlassen das Gerät.",
    "@privacyAiBody": {
        "description": "Label for privacyAiBody"
    },
