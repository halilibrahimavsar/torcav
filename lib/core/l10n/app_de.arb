    },
    "privacyConfigRetentionTitle": "Konfigurierbare Aufbewahrung",
    "@privacyConfigRetentionTitle": {
        "description": "Label for privacyConfigRetentionTitle"
    },
    "privacyConfigRetentionBody": "Einstellungen → Datenschutz erlaubt Aufbewahrungsfenster (7–365 Tage) für Scan-Verlauf, Speedtests und Sicherheitsereignisse. Standard: 30 Tage. Alte Einträge werden automatisch entfernt.",
    "@privacyConfigRetentionBody": {
        "description": "Label for privacyConfigRetentionBody"
    },
    "privacyWipeLocalDataTitle": "Alle lokalen Daten löschen",
    "@privacyWipeLocalDataTitle": {
        "description": "Label for privacyWipeLocalDataTitle"
    },
    "privacyWipeLocalDataBody": "Ein Tipp in Einstellungen → Datenschutz löscht jeden gespeicherten Eintrag: Scans, Geräte, Sicherheitsereignisse, Heatmap-Sitzungen, LAN-Verlauf, Exporte. Unumkehrbar.",
    "@privacyWipeLocalDataBody": {
        "description": "Label for privacyWipeLocalDataBody"
    },
