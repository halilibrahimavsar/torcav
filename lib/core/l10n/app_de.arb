    },
    "privacyDnsProbesBody": "1.1.1.1, 8.8.8.8, 9.9.9.9, OpenDNS und AdGuard werden für DNS-Benchmark und Leak-Erkennung abgefragt. Sie sehen Standard-DNS-Anfragen (keine Nutzerkennungen).",
    "@privacyDnsProbesBody": {
        "description": "Label for privacyDnsProbesBody"
    },
    "privacyCaptivePortalTitle": "Captive-Portal-Probe",
    "@privacyCaptivePortalTitle": {
        "description": "Label for privacyCaptivePortalTitle"
    },
    "privacyCaptivePortalBody": "connectivitycheck.gstatic.com erhält eine einfache HEAD-Anfrage zur Captive-Portal-Erkennung. Dieselbe Probe führt Android selbst aus.",
    "@privacyCaptivePortalBody": {
        "description": "Label for privacyCaptivePortalBody"
    },
    "privacyBreachCheckTitle": "Passwort-Leck-Prüfung (Have I Been Pwned)",
    "@privacyBreachCheckTitle": {
        "description": "Privacy policy card title for the HIBP breach check endpoint"
    },
    "privacyBreachCheckBody": "Die Leck-Prüfung fragt api.pwnedpasswords.com per k-Anonymität ab: Das Passwort wird auf diesem Gerät SHA-1-gehasht und nur die ersten 5 Zeichen des Hashes werden gesendet. Das vollständige Passwort oder der volle Hash verlässt das Telefon nie; nichts wird protokolliert oder gespeichert.",
    "@privacyBreachCheckBody": {
        "description": "Privacy policy card body for the HIBP breach check endpoint"
    },
    "privacyNoTrackersTitle": "Keine Analytics, keine Tracker, keine Werbung",
    "@privacyNoTrackersTitle": {
        "description": "Label for privacyNoTrackersTitle"
    },
    "privacyNoTrackersBody": "In v1.0 gibt es null Analytics-SDKs, null Werbe-IDs, null Crash-Reporting-Dienste. Beim App-Start wird nicht nach Hause telefoniert.",
    "@privacyNoTrackersBody": {
        "description": "Label for privacyNoTrackersBody"
    },
