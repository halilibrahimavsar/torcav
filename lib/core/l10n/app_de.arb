    "hardeningChangeAdminPasswordTitle": "Router-Admin-Passwort ändern",
    "@hardeningChangeAdminPasswordTitle": {
        "description": "Label for hardeningChangeAdminPasswordTitle"
    },
    "hardeningChangeAdminPasswordBody": "Standard-Zugangsdaten (admin/admin, admin/password) sind öffentlich dokumentiert. Jeder in Ihrem Wi-Fi kann das Admin-Panel öffnen und Einstellungen umschreiben — DNS kapern, Verkehr umleiten, Sie aussperren.",
    "@hardeningChangeAdminPasswordBody": {
        "description": "Label for hardeningChangeAdminPasswordBody"
    },
    "hardeningChangeAdminPasswordStep1": "Tippen Sie oben auf ADMIN-PANEL ÖFFNEN. Ihr Browser öffnet die Router-Login-Seite.",
    "@hardeningChangeAdminPasswordStep1": {
        "description": "Label for hardeningChangeAdminPasswordStep1"
    },
    "hardeningChangeAdminPasswordStep2": "Melden Sie sich an. Probieren Sie \"admin\" als Benutzername und \"admin\" oder \"password\" als Passwort, falls nie geändert.",
    "@hardeningChangeAdminPasswordStep2": {
        "description": "Label for hardeningChangeAdminPasswordStep2"
    },
    "hardeningChangeAdminPasswordStep3": "Suchen Sie ein Menü namens \"Administration\", \"System\", \"Maintenance\" oder \"Konto\".",
    "@hardeningChangeAdminPasswordStep3": {
        "description": "Label for hardeningChangeAdminPasswordStep3"
    },
    "hardeningChangeAdminPasswordStep4": "Suchen Sie dort nach \"Login password\", \"Admin password\" oder \"Passwort ändern\".",
    "@hardeningChangeAdminPasswordStep4": {
        "description": "Label for hardeningChangeAdminPasswordStep4"
    },
    "hardeningChangeAdminPasswordStep5": "Wählen Sie ein NEUES Passwort — mindestens 12 Zeichen, mit Groß-/Kleinbuchstaben, Zahlen und Symbol.",
    "@hardeningChangeAdminPasswordStep5": {
        "description": "Label for hardeningChangeAdminPasswordStep5"
    },
    "hardeningChangeAdminPasswordStep6": "Speichern / Übernehmen. Der Router startet ggf. ~30 Sekunden neu.",
    "@hardeningChangeAdminPasswordStep6": {
        "description": "Label for hardeningChangeAdminPasswordStep6"
    },
    "hardeningChangeAdminPasswordStep7": "Notieren Sie das neue Passwort an einem sicheren Ort.",
    "@hardeningChangeAdminPasswordStep7": {
        "description": "Label for hardeningChangeAdminPasswordStep7"
    },
    "hardeningChangeAdminPasswordStep8": "Danach hier zurückkehren und ALS ERLEDIGT MARKIEREN antippen.",
    "@hardeningChangeAdminPasswordStep8": {
        "description": "Label for hardeningChangeAdminPasswordStep8"
    },
    "hardeningUseWpa3OrWpa2AesTitle": "WPA3 nutzen, Fallback WPA2-AES",
    "@hardeningUseWpa3OrWpa2AesTitle": {
        "description": "Label for hardeningUseWpa3OrWpa2AesTitle"
    },
    "hardeningUseWpa3OrWpa2AesBody": "WPA3 ist der moderne Wi-Fi-Verschlüsselungsstandard. WPA/TKIP und WEP sind in Minuten knackbar.",
    "@hardeningUseWpa3OrWpa2AesBody": {
        "description": "Label for hardeningUseWpa3OrWpa2AesBody"
    },
    "hardeningDisableWpsTitle": "WPS deaktivieren",
    "@hardeningDisableWpsTitle": {
        "description": "Label for hardeningDisableWpsTitle"
    },
