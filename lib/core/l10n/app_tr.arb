    "@markAsTodoLabel": {},
    "hardeningUseWpa3OrWpa2AesStep1": "Üstteki düğmeyi kullanarak yönetici panelini açın.",
    "@hardeningUseWpa3OrWpa2AesStep1": {},
    "hardeningUseWpa3OrWpa2AesStep2": "Kablosuz (Wireless) bölümünü bulun: \"Wireless\", \"Wi-Fi\" veya \"WLAN\".",
    "@hardeningUseWpa3OrWpa2AesStep2": {},
    "hardeningUseWpa3OrWpa2AesStep3": "Bir güvenlik veya şifreleme ayarı arayın — genellikle \"Security mode\", \"Authentication\" veya \"Encryption\" olarak adlandırılır.",
    "@hardeningUseWpa3OrWpa2AesStep3": {},
    "hardeningUseWpa3OrWpa2AesStep4": "Şu sırayla en güçlü seçeneği belirleyin: WPA3-Personal > WPA2/WPA3 mixed > WPA2-Personal (AES). \"WPA-PSK\", \"TKIP\", \"WEP\" veya \"Open\" etiketli olanlardan kaçının — bunlar güvensizdir.",
    "@hardeningUseWpa3OrWpa2AesStep4": {},
    "hardeningUseWpa3OrWpa2AesStep5": "WPA3-Personal ayarlarsanız ve eski bir cihaz (akıllı ampul, yazıcı, eski telefon) çalışmayı durdurursa, \"WPA2/WPA3 mixed\" seçeneğine geçin — bu, eski donanımların bağlanmasına izin verirken yeni cihazların hala WPA3 kullanmasını sağlar.",
    "@hardeningUseWpa3OrWpa2AesStep5": {},
    "hardeningUseWpa3OrWpa2AesStep6": "Ayrı 2.4 GHz ve 5 GHz ayarlarınız varsa, HER İKİ bandı da değiştirin.",
    "@hardeningUseWpa3OrWpa2AesStep6": {},
    "hardeningUseWpa3OrWpa2AesStep7": "Kaydet / Uygula. Cihazlarınızın bağlantısı kısa bir süreliğine kesilebilir — birkaç saniye içinde yeniden bağlanacaklardır.",
    "@hardeningUseWpa3OrWpa2AesStep7": {},
    "hardeningUseWpa3OrWpa2AesStep8": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningUseWpa3OrWpa2AesStep8": {},
    "hardeningDisableWpsStep1": "Yönetici panelini açın.",
    "@hardeningDisableWpsStep1": {},
    "hardeningDisableWpsStep2": "Kablosuz (Wireless) veya Wi-Fi bölümünü bulun.",
    "@hardeningDisableWpsStep2": {},
    "hardeningDisableWpsStep3": "\"WPS\", \"Easy Setup\", \"Quick Connect\" adında bir alt menü veya Kablosuz Ayarlarında WPS etiketli bir sekme arayın.",
    "@hardeningDisableWpsStep3": {},
    "hardeningDisableWpsStep4": "WPS anahtarını OFF / Disabled (Kapalı) konumuna getirin.",
    "@hardeningDisableWpsStep4": {},
    "hardeningDisableWpsStep5": "Bazı yönlendiricilerin üzerinde fiziksel bir WPS düğmesi de bulunur — bu da çalışmayı durduracaktır ki amaç da budur.",
    "@hardeningDisableWpsStep5": {},
    "hardeningDisableWpsStep6": "Kaydet / Uygula.",
    "@hardeningDisableWpsStep6": {},
    "hardeningDisableWpsStep7": "Şu andan itibaren, yeni bir cihaz bağladığınızda sadece normal şekilde Wi-Fi şifresini yazın. Ekstra 10 saniye sürer, ciddi bir saldırı yolunu ortadan kaldırır.",
    "@hardeningDisableWpsStep7": {},
    "hardeningDisableWpsStep8": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningDisableWpsStep8": {},
    "hardeningEnablePmfStep1": "Yönetici panelini açın.",
    "@hardeningEnablePmfStep1": {},
    "hardeningEnablePmfStep2": "Kablosuz (Wireless) / Wi-Fi bölümüne gidin.",
    "@hardeningEnablePmfStep2": {},
    "hardeningEnablePmfStep3": "\"Advanced\" veya \"Wireless Security\" altında \"PMF\", \"802.11w\" veya \"Management Frame Protection\" adlı bir ayar arayın.",
    "@hardeningEnablePmfStep3": {},
    "hardeningEnablePmfStep4": "Tüm cihazlarınız yeni ise (son ~5 yıl) \"Required\" (Gerekli) olarak ayarlayın. Eski cihazlar ağı görmemeye başlarsa, bunu \"Optional / Capable\" (İsteğe Bağlı) olarak değiştirin — bu yine de yardımcı olur, sadece daha az kısıtlayıcıdır.",
    "@hardeningEnablePmfStep4": {},
    "hardeningEnablePmfStep5": "Bu ayarı hiçbir yerde bulamıyorsanız, yönlendiriciniz bunu WPA3 moduna entegre etmiş olabilir (bu nedenle yukarıdaki 2. adımı tamamlamak zaten kapsar). Bu durumda, buradaki TAMAMLANDI İŞARETLE'ye de dokunun.",
    "@hardeningEnablePmfStep5": {},
    "hardeningEnablePmfStep6": "Kaydet / Uygula.",
    "@hardeningEnablePmfStep6": {},
    "hardeningEnablePmfStep7": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningEnablePmfStep7": {},
    "hardeningEnableGuestNetworkStep1": "Yönetici panelini açın.",
    "@hardeningEnableGuestNetworkStep1": {},
    "hardeningEnableGuestNetworkStep2": "\"Guest Network\", \"Guest Wi-Fi\" veya \"Multi-SSID\" adında bir menü bulun.",
    "@hardeningEnableGuestNetworkStep2": {},
    "hardeningEnableGuestNetworkStep3": "Etkinleştirin. Ana Wi-Fi ağınızdan farklı bir isim verin — örneğin, ana ağınız \"Ev\" ise misafir ağına \"Ev-Misafir\" deyin.",
    "@hardeningEnableGuestNetworkStep3": {},
    "hardeningEnableGuestNetworkStep4": "Bir şifre belirleyin. Ana şifrenizden daha basit olabilir (misafirler yazacaktır), ancak yine de 10+ karakter olmalıdır.",
    "@hardeningEnableGuestNetworkStep4": {},
    "hardeningEnableGuestNetworkStep5": "\"Client Isolation\", \"AP Isolation\" veya \"Guest network isolation\" adında bir ayar arayın. Açık (ON) duruma getirin. Bu, misafir cihazların birbirleriyle veya özel ağınızla konuşmasını engeller.",
    "@hardeningEnableGuestNetworkStep5": {},
    "hardeningEnableGuestNetworkStep6": "IoT cihazlarınızı (akıllı prizler, kameralar, robot süpürge, akıllı TV vb.) misafir ağına taşıyın — onları yeni şifreyle bağlayın.",
    "@hardeningEnableGuestNetworkStep6": {},
    "hardeningEnableGuestNetworkStep7": "Kaydet / Uygula.",
    "@hardeningEnableGuestNetworkStep7": {},
    "hardeningEnableGuestNetworkStep8": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningEnableGuestNetworkStep8": {},
    "hardeningDisableRemoteAdminStep1": "Yönetici panelini açın.",
    "@hardeningDisableRemoteAdminStep1": {},
    "hardeningDisableRemoteAdminStep2": "\"Administration\", \"System Tools\" veya \"Security\" bölümüne gidin.",
    "@hardeningDisableRemoteAdminStep2": {},
    "hardeningDisableRemoteAdminStep3": "\"Remote Management\", \"Web Access from WAN\" veya \"Remote admin\" adlı bir ayar bulun.",
    "@hardeningDisableRemoteAdminStep3": {},
    "hardeningDisableRemoteAdminStep4": "Bunu OFF / Disabled (Kapalı) konumuna getirin.",
    "@hardeningDisableRemoteAdminStep4": {},
    "hardeningDisableRemoteAdminStep5": "Buradayken, \"Cloud / Remote App access\" ayarını da kontrol edin (bazı markalarda bu vardır — TP-Link Tether, Asus Router app, Mi Wi-Fi). Bu uygulamayı aktif olarak kullanmıyorsanız, onu da kapatın.",
    "@hardeningDisableRemoteAdminStep5": {},
    "hardeningDisableRemoteAdminStep6": "Kaydet / Uygula.",
    "@hardeningDisableRemoteAdminStep6": {},
    "hardeningDisableRemoteAdminStep7": "Yönlendiricinizi hala evinizin içinden yönetebilirsiniz — sadece uzaktan / genel internet yolu kapatılmıştır.",
    "@hardeningDisableRemoteAdminStep7": {},
    "hardeningDisableRemoteAdminStep8": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningDisableRemoteAdminStep8": {},
    "hardeningUpdateFirmwareStep1": "Yönetici panelini açın.",
    "@hardeningUpdateFirmwareStep1": {},
    "hardeningUpdateFirmwareStep2": "\"Firmware Update\", \"System Update\", \"Online Upgrade\" veya \"Maintenance\" adında bir menü bulun.",
    "@hardeningUpdateFirmwareStep2": {},
    "hardeningUpdateFirmwareStep3": "\"Check for update\" veya \"Online check\" seçeneğine dokunun. Yönlendirici üretici sunucusunda daha yeni bir sürüm arayacaktır.",
    "@hardeningUpdateFirmwareStep3": {},
    "hardeningUpdateFirmwareStep4": "Bir güncelleme teklif edilirse kurun. Yönlendirici 2-5 dakika boyunca yeniden başlayacaktır — güncelleme sırasında cihazın FİŞİNİ ÇEKMEYİN, aksi takdirde cihaz kullanılamaz hale gelebilir.",
    "@hardeningUpdateFirmwareStep4": {},
    "hardeningUpdateFirmwareStep5": "Cihaz geri geldikten sonra aynı menüye gidin ve \"Auto update\" veya \"Automatic upgrade\" arayın. Varsa ON (Açık) konumuna getirin.",
    "@hardeningUpdateFirmwareStep5": {},
    "hardeningUpdateFirmwareStep6": "Bazı eski yönlendiricilerde çevrimiçi güncelleme bulunmaz. Bu durumda cihaz etiketinden yönlendirici modelini not edin, üretici web sitesinde arayın, en son aygıt yazılımı dosyasını indirin ve aynı menüdeki \"Manual upload\" seçeneğini kullanın.",
    "@hardeningUpdateFirmwareStep6": {},
    "hardeningUpdateFirmwareStep7": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningUpdateFirmwareStep7": {},
    "hardeningStrongPassphraseStep1": "Yönetici panelini açın.",
    "@hardeningStrongPassphraseStep1": {},
    "hardeningStrongPassphraseStep2": "\"Wireless\", \"Wi-Fi\" veya \"WLAN\" bölümüne gidin.",
    "@hardeningStrongPassphraseStep2": {},
    "hardeningStrongPassphraseStep3": "Şifre alanını bulun — \"Wireless password\", \"Pre-Shared Key (PSK)\", \"Wireless Key\" veya sadece \"Password\" olarak etiketlenmiştir.",
    "@hardeningStrongPassphraseStep3": {},
    "hardeningStrongPassphraseStep4": "YENİ bir parola ile değiştirin: en az 12 karakter; büyük harf, küçük harf, rakam ve sembol karışımı olmalıdır. Sözlük kelimelerinden ve kişisel bilgilerden (doğum günleri, evcil hayvan adları) kaçının.",
    "@hardeningStrongPassphraseStep4": {},
    "hardeningStrongPassphraseStep5": "İyi bir taktik: birbiriyle ilgisiz üç kelime artı bir sayı seçin, örn. \"dogru-at-batarya-9\". Uzun parolaları kırmak, kısa ama karmaşık olanları kırmaktan daha zordur.",
    "@hardeningStrongPassphraseStep5": {},
    "hardeningStrongPassphraseStep6": "Ayrı 2.4 GHz ve 5 GHz ağlarınız varsa, HER İKİSİNİ de değiştirin.",
    "@hardeningStrongPassphraseStep6": {},
    "hardeningStrongPassphraseStep7": "Kaydet / Uygula. Her cihazın bağlantısı kesilecektir — her birine yeni şifreyi tekrar girin.",
    "@hardeningStrongPassphraseStep7": {},
    "hardeningStrongPassphraseStep8": "Şifreyi bir yere not edin (şifre yöneticisi, ziyaretçiler için buzdolabı notu, vb. hangisi size uyuyorsa).",
    "@hardeningStrongPassphraseStep8": {},
    "hardeningStrongPassphraseStep9": "Buraya geri dönün ve TAMAMLANDI İŞARETLE'ye dokunun.",
    "@hardeningStrongPassphraseStep9": {}
}
