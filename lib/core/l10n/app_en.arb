    "hardeningChangeAdminPasswordTitle": "Change router admin password",
    "@hardeningChangeAdminPasswordTitle": {},
    "hardeningChangeAdminPasswordBody": "Default admin credentials (admin/admin, admin/password) are publicly documented. Anyone on your Wi-Fi can open the admin panel and rewrite settings — DNS hijack, redirect traffic, lock you out.",
    "@hardeningChangeAdminPasswordBody": {},
    "hardeningChangeAdminPasswordStep1": "Tap the big OPEN ADMIN PANEL button at the top of this page. Your browser will open the router login page.",
    "@hardeningChangeAdminPasswordStep1": {},
    "hardeningChangeAdminPasswordStep2": "Log in. Try \"admin\" as username and \"admin\" or \"password\" as password if you haven't changed it.",
    "@hardeningChangeAdminPasswordStep2": {},
    "hardeningChangeAdminPasswordStep3": "Find a menu named \"Administration\", \"System\", \"Maintenance\" or \"Account\".",
    "@hardeningChangeAdminPasswordStep3": {},
    "hardeningChangeAdminPasswordStep4": "Inside that menu look for \"Login password\", \"Admin password\" or \"Change password\".",
    "@hardeningChangeAdminPasswordStep4": {},
    "hardeningChangeAdminPasswordStep5": "Pick a NEW password — at least 12 characters, mix uppercase, lowercase, numbers and a symbol.",
    "@hardeningChangeAdminPasswordStep5": {},
    "hardeningChangeAdminPasswordStep6": "Save / Apply. The router may reboot for ~30 seconds.",
    "@hardeningChangeAdminPasswordStep6": {},
    "hardeningChangeAdminPasswordStep7": "Write the new password down somewhere safe.",
    "@hardeningChangeAdminPasswordStep7": {},
    "hardeningChangeAdminPasswordStep8": "Once saved, come back here and tap MARK DONE.",
    "@hardeningChangeAdminPasswordStep8": {},
    "hardeningUseWpa3OrWpa2AesTitle": "Use WPA3, fall back to WPA2-AES",
    "@hardeningUseWpa3OrWpa2AesTitle": {},
    "hardeningUseWpa3OrWpa2AesBody": "WPA3 is the modern Wi-Fi encryption standard. WPA/TKIP and WEP can be cracked in minutes.",
    "@hardeningUseWpa3OrWpa2AesBody": {},
