    },
    "privacyWifiAnalysisBody": "Nearby SSID/BSSID/RSSI metadata and security flags (WPA2/WPA3/WPS/PMF) are read from the OS scan API. This data stays in a local SQLite database encrypted at rest. It is never uploaded.",
    "@privacyWifiAnalysisBody": {
        "description": "Label for privacyWifiAnalysisBody"
    },
    "privacyLanInventoryTitle": "LAN Device Inventory",
    "@privacyLanInventoryTitle": {
        "description": "Label for privacyLanInventoryTitle"
    },
    "privacyLanInventoryBody": "When you run a LAN scan, the app collects IP/MAC/hostname/vendor/open ports for devices on the same network. This may include third-party devices — anonymisation is on by default for exports.",
    "@privacyLanInventoryBody": {
        "description": "Label for privacyLanInventoryBody"
    },
    "privacyLocationTitle": "Location Permission (Wi-Fi only)",
    "@privacyLocationTitle": {
        "description": "Label for privacyLocationTitle"
    },
    "privacyLocationBody": "Android requires the location permission to enable Wi-Fi scanning. Torcav uses it strictly for that — we do not read GPS coordinates and we do not track movement.",
    "@privacyLocationBody": {
        "description": "Label for privacyLocationBody"
    },
    "privacySensorsTitle": "Sensors & Heatmap",
    "@privacySensorsTitle": {
        "description": "Label for privacySensorsTitle"
    },
    "privacySensorsBody": "Activity recognition + IMU/barometer are used during heatmap surveys to map signal strength to your relative path (origin = scan start). GPS is not used.",
    "@privacySensorsBody": {
        "description": "Label for privacySensorsBody"
    },
    "privacyAiTitle": "AI / Local Classification",
    "@privacyAiTitle": {
        "description": "Label for privacyAiTitle"
    },
    "privacyAiBody": "Device-type identification uses a local ONNX model. No proprietary or vendor data leaves the device.",
    "@privacyAiBody": {
        "description": "Label for privacyAiBody"
    },
    "privacyExternalEndpointsTitle": "EXTERNAL ENDPOINTS",
