    },
    "whatItDoesBullet1": "Establishes a local VPN tunnel on your device — no traffic leaves through any third-party server.",
    "@whatItDoesBullet1": {
        "description": "Label for whatItDoesBullet1"
    },
    "whatItDoesBullet2": "Routes DNS queries to the fastest resolver (1.1.1.1, 8.8.8.8, 9.9.9.9, …) measured live.",
    "@whatItDoesBullet2": {
        "description": "Label for whatItDoesBullet2"
    },
    "whatItDoesBullet3": "Watches latency / jitter every second and warns you when a spike persists, optionally cycling the tunnel to break a sticky bad path.",
    "@whatItDoesBullet3": {
        "description": "Label for whatItDoesBullet3"
    },
    "whatItDoesBullet4": "Uses an EWMA filter (recent samples weighted heavier) so it reacts to real degradation, not single-packet noise.",
    "@whatItDoesBullet4": {
        "description": "Label for whatItDoesBullet4"
    },
    "whatItDoesNotTitle": "What it does NOT do",
    "@whatItDoesNotTitle": {
        "description": "Label for whatItDoesNotTitle"
    },
    "whatItDoesNotBullet1": "It cannot make your ISP's route to the game server physically shorter — no on-device app can.",
    "@whatItDoesNotBullet1": {
        "description": "Label for whatItDoesNotBullet1"
    },
    "whatItDoesNotBullet2": "It does not replace a paid VPN/relay service like ExitLag or WTFast (those route via their own servers; this is local-only).",
    "@whatItDoesNotBullet2": {
        "description": "Label for whatItDoesNotBullet2"
    },
    "whatItDoesNotBullet3": "Multi-path \"first-wins\" send across Wi-Fi + cellular is on the roadmap (Phase 2) and currently disabled.",
