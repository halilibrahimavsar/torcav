    "spectrumOptimizationOpsSubtitle": "Channel rating · interference",
    "@spectrumOptimizationOpsSubtitle": {
        "description": "Operations Hub subtitle for the Spectrum Optimization card"
    },
    "aboutSpectrumTitle": "What is Spectrum Optimization?",
    "@aboutSpectrumTitle": {
        "description": "Title of the about-spectrum expandable info panel"
    },
    "aboutSpectrumWhatHeader": "What is it?",
    "@aboutSpectrumWhatHeader": {
        "description": "Header for the 'What is it' subsection"
    },
    "aboutSpectrumWhatBody": "Wi-Fi devices communicate over slices of the radio spectrum called channels. The 2.4 GHz band has only 3 truly non-overlapping channels (1, 6, 11) and is the most crowded. The 5 GHz band has many more channels and less interference. The newest 6 GHz band (Wi-Fi 6E/7) is almost empty in most homes.",
    "@aboutSpectrumWhatBody": {
        "description": "Body for 'What is it' subsection"
    },
    "aboutSpectrumWhyHeader": "What is it for?",
    "@aboutSpectrumWhyHeader": {
        "description": "Header for the 'What it does' subsection"
    },
    "aboutSpectrumWhyBody": "When many networks share the same channel, they take turns talking, which slows everything down (Co-channel Interference). On 2.4 GHz, even nearby channels overlap and create static (Adjacent Channel Interference). Picking a quiet channel directly improves speed, latency and connection stability.",
    "@aboutSpectrumWhyBody": {
        "description": "Body for 'What it does' subsection"
    },
    "aboutSpectrumHowHeader": "How does it work?",
    "@aboutSpectrumHowHeader": {
        "description": "Header for the 'How' subsection"
    },
    "aboutSpectrumHowBody": "This screen scans every Wi-Fi network within range, then scores each channel from 0 to 10 based on the number of competing networks, their signal strength and any overlap with neighbors. Pick a channel marked green (≥8): it is the least crowded right now. The History tab shows whether that channel stays clear over time.",
    "@aboutSpectrumHowBody": {
        "description": "Body for 'How' subsection"
    },
    "bandSpectrumTitle": "Channel Spectrum",
    "@bandSpectrumTitle": {
        "description": "Header above the per-band spectrum bar chart"
    },
    "bandSpectrumInfoTitle": "Channel Spectrum",
    "@bandSpectrumInfoTitle": {
        "description": "Title of the Channel Spectrum info sheet"
    },
    "bandSpectrumInfoBody": "Each bar is one channel. Taller and greener bars are quieter; shorter red bars are crowded. Tap a bar to see the score (0-10). The score drops by 2 for every Wi-Fi network sharing the channel (Co-channel Interference) and by smaller amounts for networks on neighboring 2.4 GHz channels (Adjacent Channel Interference). Strong nearby networks penalise more than weak distant ones.",
    "@bandSpectrumInfoBody": {
        "description": "Body of the Channel Spectrum info sheet"
    },
    "recommendationInfoTitle": "How is the Recommendation Made?",
    "@recommendationInfoTitle": {
        "description": "Title of the recommendation info sheet"
    },
    "recommendationInfoBody": "We start every channel at 10 points, then subtract for each interfering network. Co-channel networks take 2 points each (×signal strength). Adjacent 2.4 GHz networks take 0.2-1.5 points based on distance. DFS channels lose 0.5 points (radar-shared). The channel with the highest remaining score wins. If two channels tie, the lower-numbered one is preferred.",
    "@recommendationInfoBody": {
        "description": "Body of the recommendation info sheet"
    },
    "consistentChannelInfoTitle": "Consistent Best Channel",
    "@consistentChannelInfoTitle": {
        "description": "Title of the consistent best channel info sheet"
    },
    "consistentChannelInfoBody": "A snapshot can be misleading: a quiet channel right now may get crowded later. We average all your past scans on each channel and surface the one that consistently scores highest. If this differs from the current snapshot, the historically stable channel is often the safer long-term choice.",
    "@consistentChannelInfoBody": {
        "description": "Body of the consistent best channel info sheet"
    },
    "dfsBadgeLabel": "DFS",
    "@dfsBadgeLabel": {
        "description": "Short DFS badge label shown next to channel tiles"
    },
    "dfsBadgeTooltip": "DFS — shared with weather/military radar; your router may briefly switch off this channel",
    "@dfsBadgeTooltip": {
        "description": "Tooltip explaining DFS badge"
    },
    "dfsInfoTitle": "What is DFS?",
    "@dfsInfoTitle": {
        "description": "Title of the DFS info sheet"
    },
    "dfsInfoBody": "DFS (Dynamic Frequency Selection) channels in the 5 GHz band (52-64 and 100-144) are legally shared with weather and military radar. Wi-Fi must give priority to those radars: if the router detects a radar pulse, it has to leave the channel for at least 60 seconds — your devices will briefly disconnect and switch to another channel. DFS channels are usually less crowded (so the score is high), but they can be unreliable near airports, harbors or weather stations. We deduct 0.5 points from the score to reflect that risk. Use them if you have no nearby radar source; avoid them otherwise.",
    "@dfsInfoBody": {
        "description": "Body of the DFS info sheet"
    },
