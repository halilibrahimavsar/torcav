    "sdSlowDnsWhatIs": "DNS turns names like example.com into the IP addresses your device actually connects to. Every page load fires off a handful of these lookups before any data flows.",
    "@sdSlowDnsWhatIs": {
        "description": "Label for sdSlowDnsWhatIs"
    },
    "sdSlowDnsWhyItMatters": "Slow DNS does not lower your download speed — it adds a delay at the start of every connection. The web feels \"laggy\" even when speed tests look fine.",
    "@sdSlowDnsWhyItMatters": {
        "description": "Label for sdSlowDnsWhyItMatters"
    },
    "sdSlowDnsHowToFix1": "Switch your device or router DNS to a fast public resolver — 1.1.1.1 (Cloudflare), 8.8.8.8 (Google), or 9.9.9.9 (Quad9).",
    "@sdSlowDnsHowToFix1": {
        "description": "Label for sdSlowDnsHowToFix1"
    },
    "sdSlowDnsHowToFix2": "Enable DNS-over-HTTPS (DoH) or DNS-over-TLS (DoT) in your OS or browser to also encrypt the lookups.",
    "@sdSlowDnsHowToFix2": {
        "description": "Label for sdSlowDnsHowToFix2"
    },
    "sdSlowDnsHowToFix3": "If your ISP's DNS is slow, set the resolver on the router so the whole household benefits, not just one device.",
    "@sdSlowDnsHowToFix3": {
        "description": "Label for sdSlowDnsHowToFix3"
    },
