    "hardeningUseWpa3OrWpa2AesStep1": "Open the admin panel using the button at the top.",
    "@hardeningUseWpa3OrWpa2AesStep1": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep1"
    },
    "hardeningUseWpa3OrWpa2AesStep2": "Find the wireless section: \"Wireless\", \"Wi-Fi\" or \"WLAN\".",
    "@hardeningUseWpa3OrWpa2AesStep2": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep2"
    },
    "hardeningUseWpa3OrWpa2AesStep3": "Look for a security or encryption setting — usually called \"Security mode\", \"Authentication\" or \"Encryption\".",
    "@hardeningUseWpa3OrWpa2AesStep3": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep3"
    },
    "hardeningUseWpa3OrWpa2AesStep4": "Choose the strongest option in this order: WPA3-Personal > WPA2/WPA3 mixed > WPA2-Personal (AES). Avoid anything labelled \"WPA-PSK\", \"TKIP\", \"WEP\" or \"Open\" — these are insecure.",
    "@hardeningUseWpa3OrWpa2AesStep4": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep4"
    },
    "hardeningUseWpa3OrWpa2AesStep5": "If you set WPA3-Personal and an old device (smart bulb, printer, older phone) stops working, switch to \"WPA2/WPA3 mixed\" — that lets old gear connect while new devices still use WPA3.",
    "@hardeningUseWpa3OrWpa2AesStep5": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep5"
    },
    "hardeningUseWpa3OrWpa2AesStep6": "If you have separate 2.4 GHz and 5 GHz settings, change BOTH bands.",
    "@hardeningUseWpa3OrWpa2AesStep6": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep6"
    },
    "hardeningUseWpa3OrWpa2AesStep7": "Save / Apply. Your devices may briefly disconnect — they will rejoin in a few seconds.",
    "@hardeningUseWpa3OrWpa2AesStep7": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep7"
    },
    "hardeningUseWpa3OrWpa2AesStep8": "Come back here and tap MARK DONE.",
    "@hardeningUseWpa3OrWpa2AesStep8": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep8"
    },
    "hardeningDisableWpsStep1": "Open the admin panel.",
    "@hardeningDisableWpsStep1": {
        "description": "Label for hardeningDisableWpsStep1"
    },
    "hardeningDisableWpsStep2": "Find the Wireless or Wi-Fi section.",
    "@hardeningDisableWpsStep2": {
        "description": "Label for hardeningDisableWpsStep2"
    },
    "hardeningDisableWpsStep3": "Look for a sub-menu called \"WPS\", \"Easy Setup\", \"Quick Connect\" or a tab inside Wireless Settings labelled WPS.",
    "@hardeningDisableWpsStep3": {
        "description": "Label for hardeningDisableWpsStep3"
    },
    "hardeningDisableWpsStep4": "Switch the WPS toggle to OFF / Disabled.",
    "@hardeningDisableWpsStep4": {
        "description": "Label for hardeningDisableWpsStep4"
    },
    "hardeningDisableWpsStep5": "Some routers also have a physical WPS button on the device — that will stop working too, which is the goal.",
    "@hardeningDisableWpsStep5": {
        "description": "Label for hardeningDisableWpsStep5"
    },
    "hardeningDisableWpsStep6": "Save / Apply.",
    "@hardeningDisableWpsStep6": {
        "description": "Label for hardeningDisableWpsStep6"
    },
    "hardeningDisableWpsStep7": "From now on, when you connect a new device just type the Wi-Fi password normally. Takes 10 extra seconds, removes a serious attack path.",
    "@hardeningDisableWpsStep7": {
        "description": "Label for hardeningDisableWpsStep7"
    },
    "hardeningDisableWpsStep8": "Come back here and tap MARK DONE.",
    "@hardeningDisableWpsStep8": {
        "description": "Label for hardeningDisableWpsStep8"
    },
    "hardeningEnablePmfStep1": "Open the admin panel.",
    "@hardeningEnablePmfStep1": {
        "description": "Label for hardeningEnablePmfStep1"
    },
    "hardeningEnablePmfStep2": "Go to the Wireless / Wi-Fi section.",
    "@hardeningEnablePmfStep2": {
        "description": "Label for hardeningEnablePmfStep2"
    },
    "hardeningEnablePmfStep3": "Look in \"Advanced\" or \"Wireless Security\" for a setting called \"PMF\", \"802.11w\" or \"Management Frame Protection\".",
    "@hardeningEnablePmfStep3": {
        "description": "Label for hardeningEnablePmfStep3"
    },
    "hardeningEnablePmfStep4": "Set it to \"Required\" if all your devices are recent (last ~5 years). If older devices stop seeing the network, change it to \"Optional / Capable\" — that still helps, just less strictly.",
    "@hardeningEnablePmfStep4": {
        "description": "Label for hardeningEnablePmfStep4"
    },
    "hardeningEnablePmfStep5": "If you cannot find this setting at all, your router may have it baked into WPA3 mode (so completing item 2 above already covers it). In that case, tap MARK DONE here too.",
    "@hardeningEnablePmfStep5": {
        "description": "Label for hardeningEnablePmfStep5"
    },
    "hardeningEnablePmfStep6": "Save / Apply.",
    "@hardeningEnablePmfStep6": {
        "description": "Label for hardeningEnablePmfStep6"
    },
    "hardeningEnablePmfStep7": "Come back here and tap MARK DONE.",
    "@hardeningEnablePmfStep7": {
        "description": "Label for hardeningEnablePmfStep7"
    },
    "hardeningEnableGuestNetworkStep1": "Open the admin panel.",
    "@hardeningEnableGuestNetworkStep1": {
        "description": "Label for hardeningEnableGuestNetworkStep1"
    },
    "hardeningEnableGuestNetworkStep2": "Find a menu called \"Guest Network\", \"Guest Wi-Fi\" or \"Multi-SSID\".",
    "@hardeningEnableGuestNetworkStep2": {
        "description": "Label for hardeningEnableGuestNetworkStep2"
    },
    "hardeningEnableGuestNetworkStep3": "Enable it. Give it a different name from your main Wi-Fi — for example, if your main is \"Home\", call the guest one \"Home-Guest\".",
    "@hardeningEnableGuestNetworkStep3": {
        "description": "Label for hardeningEnableGuestNetworkStep3"
    },
    "hardeningEnableGuestNetworkStep4": "Set a password. It can be simpler than your main one (guests will type it), but still 10+ characters.",
    "@hardeningEnableGuestNetworkStep4": {
        "description": "Label for hardeningEnableGuestNetworkStep4"
    },
    "hardeningEnableGuestNetworkStep5": "Look for a setting called \"Client Isolation\", \"AP Isolation\" or \"Guest network isolation\". Turn it ON. This stops guest devices from talking to each other or to your private network.",
    "@hardeningEnableGuestNetworkStep5": {
        "description": "Label for hardeningEnableGuestNetworkStep5"
    },
    "hardeningEnableGuestNetworkStep6": "Move your IoT devices (smart plugs, cameras, robot vacuum, smart TV) over to the guest network — connect them with the new password.",
    "@hardeningEnableGuestNetworkStep6": {
        "description": "Label for hardeningEnableGuestNetworkStep6"
    },
    "hardeningEnableGuestNetworkStep7": "Save / Apply.",
    "@hardeningEnableGuestNetworkStep7": {
        "description": "Label for hardeningEnableGuestNetworkStep7"
    },
    "hardeningEnableGuestNetworkStep8": "Come back here and tap MARK DONE.",
    "@hardeningEnableGuestNetworkStep8": {
        "description": "Label for hardeningEnableGuestNetworkStep8"
    },
    "hardeningDisableRemoteAdminStep1": "Open the admin panel.",
    "@hardeningDisableRemoteAdminStep1": {
        "description": "Label for hardeningDisableRemoteAdminStep1"
    },
    "hardeningDisableRemoteAdminStep2": "Go to \"Administration\", \"System Tools\" or \"Security\".",
    "@hardeningDisableRemoteAdminStep2": {
        "description": "Label for hardeningDisableRemoteAdminStep2"
    },
    "hardeningDisableRemoteAdminStep3": "Find a setting called \"Remote Management\", \"Web Access from WAN\" or \"Remote admin\".",
    "@hardeningDisableRemoteAdminStep3": {
        "description": "Label for hardeningDisableRemoteAdminStep3"
    },
    "hardeningDisableRemoteAdminStep4": "Switch it OFF / Disabled.",
    "@hardeningDisableRemoteAdminStep4": {
        "description": "Label for hardeningDisableRemoteAdminStep4"
    },
    "hardeningDisableRemoteAdminStep5": "While here, also check for \"Cloud / Remote App access\" (some brands have this — TP-Link Tether, Asus Router app, Mi Wi-Fi). If you do not actively use that app, turn it off too.",
    "@hardeningDisableRemoteAdminStep5": {
        "description": "Label for hardeningDisableRemoteAdminStep5"
    },
    "hardeningDisableRemoteAdminStep6": "Save / Apply.",
    "@hardeningDisableRemoteAdminStep6": {
        "description": "Label for hardeningDisableRemoteAdminStep6"
    },
    "hardeningDisableRemoteAdminStep7": "You can still manage your router from inside your home — only the remote / public-internet path is closed.",
    "@hardeningDisableRemoteAdminStep7": {
        "description": "Label for hardeningDisableRemoteAdminStep7"
    },
    "hardeningDisableRemoteAdminStep8": "Come back here and tap MARK DONE.",
    "@hardeningDisableRemoteAdminStep8": {
        "description": "Label for hardeningDisableRemoteAdminStep8"
    },
    "hardeningUpdateFirmwareStep1": "Open the admin panel.",
    "@hardeningUpdateFirmwareStep1": {
        "description": "Label for hardeningUpdateFirmwareStep1"
    },
    "hardeningUpdateFirmwareStep2": "Find a menu called \"Firmware Update\", \"System Update\", \"Online Upgrade\" or \"Maintenance\".",
    "@hardeningUpdateFirmwareStep2": {
        "description": "Label for hardeningUpdateFirmwareStep2"
    },
    "hardeningUpdateFirmwareStep3": "Tap \"Check for update\" or \"Online check\". The router will look for a newer version on the vendor server.",
    "@hardeningUpdateFirmwareStep3": {
        "description": "Label for hardeningUpdateFirmwareStep3"
    },
    "hardeningUpdateFirmwareStep4": "If an update is offered, install it. The router will reboot for 2-5 minutes — do NOT unplug it during the update or it can become a paperweight.",
    "@hardeningUpdateFirmwareStep4": {
        "description": "Label for hardeningUpdateFirmwareStep4"
    },
    "hardeningUpdateFirmwareStep5": "After it comes back, go to the same menu and look for \"Auto update\" or \"Automatic upgrade\". Turn it ON if available.",
    "@hardeningUpdateFirmwareStep5": {
        "description": "Label for hardeningUpdateFirmwareStep5"
    },
    "hardeningUpdateFirmwareStep6": "Some older routers do not have online updates. In that case, note the router model from the device sticker, search the vendor website, download the latest firmware file, and use the \"Manual upload\" option in the same menu.",
    "@hardeningUpdateFirmwareStep6": {
        "description": "Label for hardeningUpdateFirmwareStep6"
    },
    "hardeningUpdateFirmwareStep7": "Come back here and tap MARK DONE.",
    "@hardeningUpdateFirmwareStep7": {
        "description": "Label for hardeningUpdateFirmwareStep7"
    },
    "hardeningStrongPassphraseStep1": "Open the admin panel.",
    "@hardeningStrongPassphraseStep1": {
        "description": "Label for hardeningStrongPassphraseStep1"
    },
    "hardeningStrongPassphraseStep2": "Go to \"Wireless\", \"Wi-Fi\" or \"WLAN\".",
    "@hardeningStrongPassphraseStep2": {
        "description": "Label for hardeningStrongPassphraseStep2"
    },
    "hardeningStrongPassphraseStep3": "Find the password field — labelled \"Wireless password\", \"Pre-Shared Key (PSK)\", \"Wireless Key\" or simply \"Password\".",
    "@hardeningStrongPassphraseStep3": {
        "description": "Label for hardeningStrongPassphraseStep3"
    },
    "hardeningStrongPassphraseStep4": "Replace it with a NEW passphrase: at least 12 characters, with a mix of uppercase, lowercase, numbers and a symbol. Avoid dictionary words and personal info (birthdays, pet names).",
    "@hardeningStrongPassphraseStep4": {
        "description": "Label for hardeningStrongPassphraseStep4"
    },
    "hardeningStrongPassphraseStep5": "A good trick: pick three unrelated words plus a number, e.g. \"correct-horse-battery-9\". Long passphrases are harder to crack than short complex ones.",
    "@hardeningStrongPassphraseStep5": {
        "description": "Label for hardeningStrongPassphraseStep5"
    },
    "hardeningStrongPassphraseStep6": "If you have separate 2.4 GHz and 5 GHz networks, change BOTH.",
    "@hardeningStrongPassphraseStep6": {
        "description": "Label for hardeningStrongPassphraseStep6"
    },
    "hardeningStrongPassphraseStep7": "Save / Apply. Every device will disconnect — re-enter the new password on each one.",
    "@hardeningStrongPassphraseStep7": {
        "description": "Label for hardeningStrongPassphraseStep7"
    },
    "hardeningStrongPassphraseStep8": "Write the password down (password manager, fridge note for visitors, whatever works for you).",
    "@hardeningStrongPassphraseStep8": {
        "description": "Label for hardeningStrongPassphraseStep8"
    },
    "hardeningStrongPassphraseStep9": "Come back here and tap MARK DONE.",
    "@hardeningStrongPassphraseStep9": {
        "description": "Label for hardeningStrongPassphraseStep9"
    },
