    "sdWeakSignalWhatIs": "Signal strength (RSSI) measures how loudly your device hears the router. Below about −70 dBm, Wi-Fi has to drop to slower, more redundant encodings to stay reliable.",
    "@sdWeakSignalWhatIs": {
        "description": "Label for sdWeakSignalWhatIs"
    },
    "sdWeakSignalWhyItMatters": "A weak signal forces the radio into low-rate modes. Even if your internet plan is fast, the Wi-Fi link itself becomes the ceiling — downloads stall, video calls drop, and pages take longer.",
    "@sdWeakSignalWhyItMatters": {
        "description": "Label for sdWeakSignalWhyItMatters"
    },
    "sdWeakSignalHowToFix1": "Move closer to the router or to a less obstructed spot.",
    "@sdWeakSignalHowToFix1": {
        "description": "Label for sdWeakSignalHowToFix1"
    },
    "sdWeakSignalHowToFix2": "Add a mesh node / Wi-Fi extender in this area.",
    "@sdWeakSignalHowToFix2": {
        "description": "Label for sdWeakSignalHowToFix2"
    },
    "sdWeakSignalHowToFix3": "If your router supports 5 GHz or 6 GHz on this SSID, use that band when you are in line-of-sight of it.",
    "@sdWeakSignalHowToFix3": {
        "description": "Label for sdWeakSignalHowToFix3"
    },
    "sdWeakSignalHowToFix4": "Check that the router is not buried inside a cabinet, behind a TV, or next to a microwave.",
    "@sdWeakSignalHowToFix4": {
        "description": "Label for sdWeakSignalHowToFix4"
    },
    "sdWeakSignalEstimate": "Estimated gain: up to +{gain} Mbps download if you can pull the device closer to the router.",
    "@sdWeakSignalEstimate": {
        "placeholders": {
            "gain": {
                "type": "String"
            }
        },
        "description": "Label for sdWeakSignalEstimate"
    },
    "sdCrowdedChannelWhatIs": "Wi-Fi channels are shared spectrum. When several nearby access points transmit on the same channel, they have to take turns — air-time is split between all of them, including yours.",
    "@sdCrowdedChannelWhatIs": {
        "description": "Label for sdCrowdedChannelWhatIs"
    },
    "sdCrowdedChannelWhyItMatters": "On a crowded channel your throughput drops even when no one in your home is using the network. The radio is healthy, but it has to wait for its turn to talk.",
    "@sdCrowdedChannelWhyItMatters": {
        "description": "Label for sdCrowdedChannelWhyItMatters"
    },
    "sdCrowdedChannelHowToFix1": "Open the router admin page and switch the Wi-Fi channel manually (Channel Rating in the app suggests the cleanest one).",
    "@sdCrowdedChannelHowToFix1": {
        "description": "Label for sdCrowdedChannelHowToFix1"
    },
    "sdCrowdedChannelHowToFix2": "On 2.4 GHz, prefer channels 1 / 6 / 11 — they do not overlap.",
    "@sdCrowdedChannelHowToFix2": {
        "description": "Label for sdCrowdedChannelHowToFix2"
    },
    "sdCrowdedChannelHowToFix3": "If your router supports 5 GHz or 6 GHz, move the device to that band: there are far more clean channels available.",
    "@sdCrowdedChannelHowToFix3": {
        "description": "Label for sdCrowdedChannelHowToFix3"
    },
    "sdCrowdedChannelHowToFix4": "For dual-band routers, give each band its own SSID so devices stop flipping back to a crowded 2.4 GHz channel.",
    "@sdCrowdedChannelHowToFix4": {
        "description": "Label for sdCrowdedChannelHowToFix4"
    },
    "sdCrowdedChannelEstimate": "Estimated gain: up to +{gain} Mbps download after switching to a quieter channel.",
    "@sdCrowdedChannelEstimate": {
        "placeholders": {
            "gain": {
                "type": "String"
            }
        },
        "description": "Label for sdCrowdedChannelEstimate"
    },
    "sdBufferbloatWhatIs": "Bufferbloat is the latency that builds up inside your router's send buffers when the link is fully loaded — typical packets have to queue behind a backlog of bulk traffic.",
    "@sdBufferbloatWhatIs": {
        "description": "Label for sdBufferbloatWhatIs"
    },
    "sdBufferbloatWhyItMatters": "Your download speed can look great while a file is in flight, but voice calls jitter, video conferences freeze, and games lag — anything time-sensitive is held up behind the queue.",
    "@sdBufferbloatWhyItMatters": {
        "description": "Label for sdBufferbloatWhyItMatters"
    },
    "sdBufferbloatHowToFix1": "Enable QoS / SQM (sometimes called \"Smart Queue Management\" or \"Adaptive QoS\") in your router admin page.",
    "@sdBufferbloatHowToFix1": {
        "description": "Label for sdBufferbloatHowToFix1"
    },
    "sdBufferbloatHowToFix2": "Update the router firmware — modern firmware ships better queue discipline by default.",
    "@sdBufferbloatHowToFix2": {
        "description": "Label for sdBufferbloatHowToFix2"
    },
    "sdBufferbloatHowToFix3": "If the router is many years old and lacks SQM, replacing it with a recent model is often the only real fix.",
    "@sdBufferbloatHowToFix3": {
        "description": "Label for sdBufferbloatHowToFix3"
    },
    "sdBufferbloatHowToFix4": "Cap upload bandwidth in the router slightly below your real plan (e.g. 90%) so the queue lives on the router, not at the ISP.",
    "@sdBufferbloatHowToFix4": {
        "description": "Label for sdBufferbloatHowToFix4"
    },
    "sdBufferbloatEstimate": "Estimated gain: about −{reduction} ms loaded latency. Calls and gaming will feel responsive even during large downloads.",
    "@sdBufferbloatEstimate": {
        "placeholders": {
            "reduction": {
                "type": "String"
            }
        },
        "description": "Label for sdBufferbloatEstimate"
    },
    "sdIspSlowWhatIs": "Your Wi-Fi link is healthy and the radio could carry far more than what is actually flowing through it. The bottleneck sits upstream of the router.",
    "@sdIspSlowWhatIs": {
        "description": "Label for sdIspSlowWhatIs"
    },
    "sdIspSlowWhyItMatters": "No amount of router or Wi-Fi tuning will help — the link from your ISP to the router is the ceiling. Treat this as data for a plan-upgrade or support call, not as a Wi-Fi problem.",
    "@sdIspSlowWhyItMatters": {
        "description": "Label for sdIspSlowWhyItMatters"
    },
    "sdIspSlowHowToFix1": "Re-run the test with a wired Ethernet cable to confirm the radio is not at fault.",
    "@sdIspSlowHowToFix1": {
        "description": "Label for sdIspSlowHowToFix1"
    },
    "sdIspSlowHowToFix2": "Check the ISP plan you are paying for — the test result should match it within ~80% on a good day.",
    "@sdIspSlowHowToFix2": {
        "description": "Label for sdIspSlowHowToFix2"
    },
    "sdIspSlowHowToFix3": "Try at different times of day. If only evenings are slow, the ISP segment may be congested.",
    "@sdIspSlowHowToFix3": {
        "description": "Label for sdIspSlowHowToFix3"
    },
    "sdIspSlowHowToFix4": "If the result is consistently far below your plan, contact the ISP with the speed test output.",
    "@sdIspSlowHowToFix4": {
        "description": "Label for sdIspSlowHowToFix4"
    },
