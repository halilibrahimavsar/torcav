    "privacyTitle": "PRIVACY POLICY",
    "@privacyTitle": {},
    "privacyIntro": "Torcav is built on the principle of \"Privacy by Default\". Almost every byte stays on your device — no accounts, no cloud sync, no analytics, no advertising. A handful of features connect to public technical endpoints (Cloudflare, Google's captive-portal probe, public DNS resolvers) — those see only your IP, never any Torcav-internal identifier. You can wipe every persisted record with one tap.",
    "@privacyIntro": {},
    "privacyViewFullGithub": "VIEW FULL POLICY ON GITHUB",
    "@privacyViewFullGithub": {},
    "privacyFullPolicyDesc": "The card list below is a summary. The canonical, KVKK + GDPR-formatted policy is hosted at github.io.",
    "@privacyFullPolicyDesc": {},
    "privacyResponsibleTitle": "WHO IS RESPONSIBLE",
    "@privacyResponsibleTitle": {},
    "privacyIndividualDev": "Individual Developer",
    "@privacyIndividualDev": {},
    "privacyDevBody": "Torcav is operated by an individual developer (Halil İbrahim Avşar), not a registered company. You can reach the data controller directly at {email}.",
    "@privacyDevBody": {
        "placeholders": {
            "email": {
                "type": "String"
            }
        }
    },
    "privacyDataCollectionTitle": "DATA COLLECTION & USAGE",
    "@privacyDataCollectionTitle": {},
    "privacyWifiAnalysisTitle": "Wi-Fi & Network Analysis",
    "@privacyWifiAnalysisTitle": {},
    "privacyWifiAnalysisBody": "Nearby SSID/BSSID/RSSI metadata and security flags (WPA2/WPA3/WPS/PMF) are read from the OS scan API. This data stays in a local SQLite database encrypted at rest. It is never uploaded.",
    "@privacyWifiAnalysisBody": {},
    "privacyLanInventoryTitle": "LAN Device Inventory",
    "@privacyLanInventoryTitle": {},
    "privacyLanInventoryBody": "When you run a LAN scan, the app collects IP/MAC/hostname/vendor/open ports for devices on the same network. This may include third-party devices — anonymisation is on by default for exports.",
    "@privacyLanInventoryBody": {},
    "privacyLocationTitle": "Location Permission (Wi-Fi only)",
    "@privacyLocationTitle": {},
    "privacyLocationBody": "Android requires the location permission to enable Wi-Fi scanning. Torcav uses it strictly for that — we do not read GPS coordinates and we do not track movement.",
    "@privacyLocationBody": {},
    "privacySensorsTitle": "Sensors & Heatmap",
    "@privacySensorsTitle": {},
    "privacySensorsBody": "Activity recognition + IMU/barometer are used during heatmap surveys to map signal strength to your relative path (origin = scan start). GPS is not used.",
    "@privacySensorsBody": {},
    "privacyAiTitle": "AI / Local Classification",
    "@privacyAiTitle": {},
    "privacyAiBody": "Device-type identification uses a local ONNX model. No proprietary or vendor data leaves the device.",
    "@privacyAiBody": {},
    "privacyExternalEndpointsTitle": "EXTERNAL ENDPOINTS",
    "@privacyExternalEndpointsTitle": {},
    "privacyCloudflareTitle": "Cloudflare Speed Test",
    "@privacyCloudflareTitle": {},
    "privacyCloudflareBody": "Speed Doctor and the speed-test page download/upload ~300-500 MB against speed.cloudflare.com. Cloudflare sees your IP — no Torcav identifier or telemetry is attached.",
    "@privacyCloudflareBody": {},
    "privacyDnsProbesTitle": "Public DNS Probes",
    "@privacyDnsProbesTitle": {},
    "privacyDnsProbesBody": "1.1.1.1, 8.8.8.8, 9.9.9.9, OpenDNS and AdGuard are queried for DNS benchmark and leak detection. They see standard DNS queries (no user identifiers).",
    "@privacyDnsProbesBody": {},
    "privacyCaptivePortalTitle": "Captive Portal Probe",
    "@privacyCaptivePortalTitle": {},
    "privacyCaptivePortalBody": "connectivitycheck.gstatic.com receives a plain HEAD request to detect captive portals. This is the same probe Android itself runs.",
    "@privacyCaptivePortalBody": {},
    "privacyNoTrackersTitle": "No Analytics, No Trackers, No Ads",
    "@privacyNoTrackersTitle": {},
    "privacyNoTrackersBody": "There are zero analytics SDKs, zero advertising IDs, zero crash-reporting services in v1.0. We do not phone home on app start.",
    "@privacyNoTrackersBody": {},
    "privacyRetentionTitle": "RETENTION & DELETION",
    "@privacyRetentionTitle": {},
    "privacyConfigRetentionTitle": "Configurable Retention",
    "@privacyConfigRetentionTitle": {},
    "privacyConfigRetentionBody": "Settings → Privacy lets you set retention windows (7-365 days) for scan history, speed tests, and security events. Default is 30 days. Old records prune automatically.",
    "@privacyConfigRetentionBody": {},
    "privacyWipeLocalDataTitle": "Wipe All Local Data",
    "@privacyWipeLocalDataTitle": {},
    "privacyWipeLocalDataBody": "A single tap in Settings → Privacy clears every persisted record: scans, devices, security events, heatmap sessions, LAN history, exports. Irreversible.",
    "@privacyWipeLocalDataBody": {},
    "privacyRightsTitle": "YOUR RIGHTS",
    "@privacyRightsTitle": {},
    "privacyKvkkGdprTitle": "KVKK (Turkey) + GDPR (EU/EEA)",
    "@privacyKvkkGdprTitle": {},
    "privacyRightsBody": "You can request access, correction, deletion, or portability of your data. For deletion, the in-app Wipe All button is the fastest path. For other requests, email {email} — we respond within 30 days.",
