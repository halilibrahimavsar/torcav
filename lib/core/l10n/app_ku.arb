    "hardeningUseWpa3OrWpa2AesStep1": "Bi bişkoja li serî panela admin veke.",
    "@hardeningUseWpa3OrWpa2AesStep1": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep1"
    },
    "hardeningUseWpa3OrWpa2AesStep2": "Beşa bêtêl bibînin: \"Wireless\", \"Wi-Fi\" an \"WLAN\".",
    "@hardeningUseWpa3OrWpa2AesStep2": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep2"
    },
    "hardeningUseWpa3OrWpa2AesStep3": "Li mîhenga ewlehiyê an şîfrekirinê bigerin — bi gelemperî \"Security mode\", \"Authentication\" an \"Encryption\" tê gotin.",
    "@hardeningUseWpa3OrWpa2AesStep3": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep3"
    },
    "hardeningUseWpa3OrWpa2AesStep4": "Vê rêzê bihilbijêrin: WPA3-Personal > WPA2/WPA3 tevlihev > WPA2-Personal (AES). Ji her tiştê bi navê \"WPA-PSK\", \"TKIP\", \"WEP\" an \"Open\" dûr bimînin — ew ne ewle ne.",
    "@hardeningUseWpa3OrWpa2AesStep4": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep4"
    },
    "hardeningUseWpa3OrWpa2AesStep5": "Heke hûn WPA3-Personal saz bikin û cîhazek kevn (ampûla aqilmend, çapker, telefonek kevn) nesekine, biçin \"WPA2/WPA3 tevlihev\" — ev dihêle amûrên kevn girê bidin dema cîhazên nû hîna WPA3 bikar tînin.",
    "@hardeningUseWpa3OrWpa2AesStep5": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep5"
    },
    "hardeningUseWpa3OrWpa2AesStep6": "Heke mîhengên we yên 2.4 GHz û 5 GHz cûda ne, HERDU bandan biguherînin.",
    "@hardeningUseWpa3OrWpa2AesStep6": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep6"
    },
    "hardeningUseWpa3OrWpa2AesStep7": "Tomar bike / Bicîh bîne. Dibe ku cîhazên we kurt veqetin — dê di çend saniyeyan de dîsa têkevin.",
    "@hardeningUseWpa3OrWpa2AesStep7": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep7"
    },
    "hardeningUseWpa3OrWpa2AesStep8": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningUseWpa3OrWpa2AesStep8": {
        "description": "Label for hardeningUseWpa3OrWpa2AesStep8"
    },
    "hardeningDisableWpsStep1": "Panela admin veke.",
    "@hardeningDisableWpsStep1": {
        "description": "Label for hardeningDisableWpsStep1"
    },
    "hardeningDisableWpsStep2": "Beşa Wireless an Wi-Fi bibînin.",
    "@hardeningDisableWpsStep2": {
        "description": "Label for hardeningDisableWpsStep2"
    },
    "hardeningDisableWpsStep3": "Li binmenuyek bi navê \"WPS\", \"Easy Setup\", \"Quick Connect\" an tabek di Mîhengên Wireless de bi navê WPS bigerin.",
    "@hardeningDisableWpsStep3": {
        "description": "Label for hardeningDisableWpsStep3"
    },
    "hardeningDisableWpsStep4": "Vebijêrka WPS bibin OFF / Neçalak.",
    "@hardeningDisableWpsStep4": {
        "description": "Label for hardeningDisableWpsStep4"
    },
    "hardeningDisableWpsStep5": "Hin router jî bişkojek fîzîkî ya WPS li ser cîhazê hene — ew jî wê rawestin, ev armanc e.",
    "@hardeningDisableWpsStep5": {
        "description": "Label for hardeningDisableWpsStep5"
    },
    "hardeningDisableWpsStep6": "Tomar bike / Bicîh bîne.",
    "@hardeningDisableWpsStep6": {
        "description": "Label for hardeningDisableWpsStep6"
    },
    "hardeningDisableWpsStep7": "Ji niha û pê ve, dema cîhazek nû girê didin tenê şîfreya Wi-Fi bi awayê normal binivîsin. 10 saniyeyên din digire, lê rêyeke êrîşê ya cidî radike.",
    "@hardeningDisableWpsStep7": {
        "description": "Label for hardeningDisableWpsStep7"
    },
    "hardeningDisableWpsStep8": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningDisableWpsStep8": {
        "description": "Label for hardeningDisableWpsStep8"
    },
    "hardeningEnablePmfStep1": "Panela admin veke.",
    "@hardeningEnablePmfStep1": {
        "description": "Label for hardeningEnablePmfStep1"
    },
    "hardeningEnablePmfStep2": "Biçin beşa Wireless / Wi-Fi.",
    "@hardeningEnablePmfStep2": {
        "description": "Label for hardeningEnablePmfStep2"
    },
    "hardeningEnablePmfStep3": "Di \"Advanced\" an \"Wireless Security\" de li mîhengek bi navê \"PMF\", \"802.11w\" an \"Management Frame Protection\" bigerin.",
    "@hardeningEnablePmfStep3": {
        "description": "Label for hardeningEnablePmfStep3"
    },
    "hardeningEnablePmfStep4": "Heke hemû cîhazên we nû bin (~5 salên dawî), wê bikin \"Required\". Heke cîhazên kevn êdî torê nabînin, wê bikin \"Optional / Capable\" — dîsa jî dibe alîkar, tenê kêmtir tund.",
    "@hardeningEnablePmfStep4": {
        "description": "Label for hardeningEnablePmfStep4"
    },
    "hardeningEnablePmfStep5": "Heke hûn vê mîhengê qet nabînin, dibe ku router wê di moda WPA3 de bi xwe re bîne (ku gava 2 ya jorîn wê jixwe vedihewîne). Di vê rewşê de jî li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningEnablePmfStep5": {
        "description": "Label for hardeningEnablePmfStep5"
    },
    "hardeningEnablePmfStep6": "Tomar bike / Bicîh bîne.",
    "@hardeningEnablePmfStep6": {
        "description": "Label for hardeningEnablePmfStep6"
    },
    "hardeningEnablePmfStep7": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningEnablePmfStep7": {
        "description": "Label for hardeningEnablePmfStep7"
    },
    "hardeningEnableGuestNetworkStep1": "Panela admin veke.",
    "@hardeningEnableGuestNetworkStep1": {
        "description": "Label for hardeningEnableGuestNetworkStep1"
    },
    "hardeningEnableGuestNetworkStep2": "Menuyek bi navê \"Guest Network\", \"Guest Wi-Fi\" an \"Multi-SSID\" bibînin.",
    "@hardeningEnableGuestNetworkStep2": {
        "description": "Label for hardeningEnableGuestNetworkStep2"
    },
    "hardeningEnableGuestNetworkStep3": "Wê çalak bikin. Navek cûda ji Wi-Fiya xwe ya sereke bidin wê — mînak, heke ya we ya sereke \"Home\" e, ya mêvan jê re \"Home-Guest\" bibêjin.",
    "@hardeningEnableGuestNetworkStep3": {
        "description": "Label for hardeningEnableGuestNetworkStep3"
    },
    "hardeningEnableGuestNetworkStep4": "Şîfreyekê saz bikin. Dikare ji ya sereke hêsantir be (mêvan wê binivîsin), lê dîsa jî 10+ tîp.",
    "@hardeningEnableGuestNetworkStep4": {
        "description": "Label for hardeningEnableGuestNetworkStep4"
    },
    "hardeningEnableGuestNetworkStep5": "Li mîhengek bi navê \"Client Isolation\", \"AP Isolation\" an \"Guest network isolation\" bigerin. Wê BIKIN ON. Ev pêşî li cîhazên mêvan digire ku bi hev re an bi torê we ya taybet re bipeyivin.",
    "@hardeningEnableGuestNetworkStep5": {
        "description": "Label for hardeningEnableGuestNetworkStep5"
    },
    "hardeningEnableGuestNetworkStep6": "Cîhazên xwe yên IoT (pirîza aqilmend, kamera, robota paqijiyê, TV aqilmend) bibin ser torê mêvan — bi şîfreya nû girê bidin.",
    "@hardeningEnableGuestNetworkStep6": {
        "description": "Label for hardeningEnableGuestNetworkStep6"
    },
    "hardeningEnableGuestNetworkStep7": "Tomar bike / Bicîh bîne.",
    "@hardeningEnableGuestNetworkStep7": {
        "description": "Label for hardeningEnableGuestNetworkStep7"
    },
    "hardeningEnableGuestNetworkStep8": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningEnableGuestNetworkStep8": {
        "description": "Label for hardeningEnableGuestNetworkStep8"
    },
    "hardeningDisableRemoteAdminStep1": "Panela admin veke.",
    "@hardeningDisableRemoteAdminStep1": {
        "description": "Label for hardeningDisableRemoteAdminStep1"
    },
    "hardeningDisableRemoteAdminStep2": "Biçin \"Administration\", \"System Tools\" an \"Security\".",
    "@hardeningDisableRemoteAdminStep2": {
        "description": "Label for hardeningDisableRemoteAdminStep2"
    },
    "hardeningDisableRemoteAdminStep3": "Mîhengek bi navê \"Remote Management\", \"Web Access from WAN\" an \"Remote admin\" bibînin.",
    "@hardeningDisableRemoteAdminStep3": {
        "description": "Label for hardeningDisableRemoteAdminStep3"
    },
    "hardeningDisableRemoteAdminStep4": "Wê bikin OFF / Neçalak.",
    "@hardeningDisableRemoteAdminStep4": {
        "description": "Label for hardeningDisableRemoteAdminStep4"
    },
    "hardeningDisableRemoteAdminStep5": "Li vir dema hene, herwiha \"Cloud / Remote App access\" jî kontrol bikin (hin marka wê hene — TP-Link Tether, Asus Router app, Mi Wi-Fi). Heke hûn bi çalakî wê sepanê bikar naînin, wê jî bigirin.",
    "@hardeningDisableRemoteAdminStep5": {
        "description": "Label for hardeningDisableRemoteAdminStep5"
    },
    "hardeningDisableRemoteAdminStep6": "Tomar bike / Bicîh bîne.",
    "@hardeningDisableRemoteAdminStep6": {
        "description": "Label for hardeningDisableRemoteAdminStep6"
    },
    "hardeningDisableRemoteAdminStep7": "Hûn hîna jî dikarin routera xwe ji hundirê mala xwe ve bi rê ve bibin — tenê rêya dûr / înternetê ya giştî hatiye girtin.",
    "@hardeningDisableRemoteAdminStep7": {
        "description": "Label for hardeningDisableRemoteAdminStep7"
    },
    "hardeningDisableRemoteAdminStep8": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningDisableRemoteAdminStep8": {
        "description": "Label for hardeningDisableRemoteAdminStep8"
    },
    "hardeningUpdateFirmwareStep1": "Panela admin veke.",
    "@hardeningUpdateFirmwareStep1": {
        "description": "Label for hardeningUpdateFirmwareStep1"
    },
    "hardeningUpdateFirmwareStep2": "Menuyek bi navê \"Firmware Update\", \"System Update\", \"Online Upgrade\" an \"Maintenance\" bibînin.",
    "@hardeningUpdateFirmwareStep2": {
        "description": "Label for hardeningUpdateFirmwareStep2"
    },
    "hardeningUpdateFirmwareStep3": "Li \"Check for update\" an \"Online check\" bitikînin. Router li serverê hilberîner li guhertoyeke nûtir digere.",
    "@hardeningUpdateFirmwareStep3": {
        "description": "Label for hardeningUpdateFirmwareStep3"
    },
    "hardeningUpdateFirmwareStep4": "Heke nûvekirinek were pêşkêşkirin, wê saz bikin. Router dê 2-5 xulekan ji nû ve dest pê bike — di dema nûvekirinê de wê ji pêvajokê JIBER NEKIN, wekî din dibe ku bêkêr bibe.",
    "@hardeningUpdateFirmwareStep4": {
        "description": "Label for hardeningUpdateFirmwareStep4"
    },
    "hardeningUpdateFirmwareStep5": "Piştî ku vegeriya, biçin heman menuyê û li \"Auto update\" an \"Automatic upgrade\" bigerin. Heke berdest be wê bikin ON.",
    "@hardeningUpdateFirmwareStep5": {
        "description": "Label for hardeningUpdateFirmwareStep5"
    },
    "hardeningUpdateFirmwareStep6": "Hin routerên kevntir nûvekirina serhêl nikarin. Di vê rewşê de, modela routerê ji stîkera cîhazê binivîsin, malpera hilberîner bigerin, dosyeya firmware ya herî nû dakêşin, û vebijêrka \"Manual upload\" ya di heman menuyê de bikar bînin.",
    "@hardeningUpdateFirmwareStep6": {
        "description": "Label for hardeningUpdateFirmwareStep6"
    },
    "hardeningUpdateFirmwareStep7": "Vegerin vir û li WEK QEDIYAYÎ NÎŞAN BIKE bitikînin.",
    "@hardeningUpdateFirmwareStep7": {
        "description": "Label for hardeningUpdateFirmwareStep7"
    },
    "hardeningStrongPassphraseStep1": "Panela admin veke.",
    "@hardeningStrongPassphraseStep1": {
        "description": "Label for hardeningStrongPassphraseStep1"
    },
    "hardeningStrongPassphraseStep2": "Biçin \"Wireless\", \"Wi-Fi\" an \"WLAN\".",
    "@hardeningStrongPassphraseStep2": {
        "description": "Label for hardeningStrongPassphraseStep2"
    },
    "hardeningStrongPassphraseStep3": "Qada şîfreyê bibînin — bi navê \"Wireless password\", \"Pre-Shared Key (PSK)\", \"Wireless Key\" an tenê \"Password\".",
    "@hardeningStrongPassphraseStep3": {
        "description": "Label for hardeningStrongPassphraseStep3"
    },
    "hardeningStrongPassphraseStep4": "Wê bi şîfreyeke NÛ biguherînin: bi kêmî 12 tîp, tevlihevî ya tîpên mezin, biçûk, hejmar û sembolekî. Ji peyvên ferhengê û agahiyên şexsî (rojbûn, navên heywanên malê) dûr bimînin.",
    "@hardeningStrongPassphraseStep4": {
        "description": "Label for hardeningStrongPassphraseStep4"
